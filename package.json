{
  "name": "soppy-slidev",
  "private": true,
  "scripts": {
    "format": "prettier --write --experimental-cli .",
    "lint": "eslint . --ext .js,.ts,.vue,.json --max-warnings 0",
    "play:cqupt": "pnpm --filter @soppy-slidev/play-cqupt dev",
    "build:cqupt": "pnpm --filter @soppy-slidev/play-cqupt build",
    "export:cqupt": "pnpm --filter @soppy-slidev/play-cqupt export",
    "lint:fix": "pnpm lint --fix",
    "version": "changeset version",
    "release": "changeset publish",
    "prepare": "husky"
  },
  "license": "MIT",
  "author": "soppylzz",
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.0",
    "@changesets/cli": "^3.0.1",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@eslint/js": "^9.39.5",
    "@types/node": "^26.4.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsonc": "^3.4.2",
    "eslint-plugin-vue": "^10.10.0",
    "globals": "^17.11.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.4.1",
    "prettier": "^3.9.6",
    "prettier-plugin-slidev": "^1.0.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.68.0",
    "vite": "catalog:",
    "vue": "catalog:",
    "vue-eslint-parser": "^10.4.1"
  },
  "lint-staged": {
    "*.{js,ts,vue,json}": [
      "eslint --fix --concurrency=auto",
      "prettier --write --experimental-cli"
    ]
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^11.18.0",
      "onFail": "download"
    }
  }
}
